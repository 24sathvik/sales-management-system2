NEXT_PUBLIC_SUPABASE_URL=https://[project_ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# REPLACE [YOUR_DATABASE_PASSWORD] with your actual Supabase project database password!
# Set this to the pooled connection string (port 6543, pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres.[project_ref]:[YOUR_DATABASE_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Set this to the direct connection string (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR_DATABASE_PASSWORD]@db.[project_ref].supabase.co:5432/postgres"

NEXTAUTH_SECRET="my_super_secret_key_change_me"
NEXTAUTH_URL="http://localhost:3000"

# Enable this to show the "Demo Mode" badge in the UI
NEXT_PUBLIC_DEMO_MODE="true"